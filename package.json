{
  "name": "@local/dsh-openbot-artist-bridge",
  "version": "0.1.0",
  "type": "module",
  "description": "Connect OpenBot ACP conversations to an existing DS Bot in DSH Desktop.",
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "openbot",
    "acp",
    "ds-bot"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shiyoungwoo/dsh-openbot-artist-bridge.git"
  },
  "homepage": "https://github.com/shiyoungwoo/dsh-openbot-artist-bridge#readme",
  "bugs": {
    "url": "https://github.com/shiyoungwoo/dsh-openbot-artist-bridge/issues"
  },
  "engines": { "node": ">=22.19.0", "dsh": ">=0.2.1-rc.3 <0.3.0" },
  "exports": { ".": "./index.js", "./locale/*.json": "./locale/*.json", "./icon": "./icon.svg" },
  "files": ["index.js", "runtime.mjs", "acp_bridge.py", "cordis.patch.yml", "locale/*.json", "icon.svg", "dsh-plugin.naming.json"],
  "dependencies": { "@deepseek-ai/schemastery": "3.18.5" },
  "scripts": {
    "check": "node --check index.js && node --check runtime.mjs && python3 -m py_compile acp_bridge.py",
    "test": "node --test tests/host.test.mjs",
    "test:acp": "python3 -m unittest discover -s tests -p 'test_*.py'"
  },
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } }
}
